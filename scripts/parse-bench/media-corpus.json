    { "id": "a-dash-paulallen-m4a", "section": "a", "derived": { "from": "a-able-paulallen-mp3", "args": ["-map", "0:a", "-c:a", "aac", "-b:a", "48k", "-f", "dash", "-single_file", "1", "-seg_duration", "10", "-global_sidx", "1"], "how": "ffmpeg's DASH muxer, one file, one global sidx: the shape of YouTube's DASH audio streams (ftyp, moov, sidx, then moof+mdat segments)" }, "exercises": "a DASH audio stream indexed by one sidx" },
    { "id": "a-dash-chained-paulallen-m4a", "section": "a", "derived": { "from": "a-able-paulallen-mp3", "args": ["-map", "0:a", "-c:a", "aac", "-b:a", "48k", "-f", "dash", "-single_file", "1", "-seg_duration", "10"], "how": "ffmpeg's DASH muxer, one file, a sidx before every segment (the layout of WPT's media-source test files)" }, "exercises": "a DASH audio stream with a sidx per segment" },
    { "id": "a-derived-recorder-webm", "section": "a", "derived": { "from": "a-able-paulallen-mp3", "args": ["-map", "0:a", "-t", "60", "-c:a", "libopus", "-b:a", "32k", "-f", "webm", "-live", "1"], "output": "out.webm", "how": "ffmpeg's WebM muxer in live mode: Opus audio, a Segment and Clusters of unknown size, the shape of a browser's MediaRecorder file" }, "exercises": "an audio-only WebM recording" },
    { "id": "a-derived-vorbis-webm", "section": "a", "derived": { "from": "a-able-paulallen-mp3", "args": ["-map", "0:a", "-t", "60", "-c:a", "libvorbis", "-b:a", "48k", "-f", "webm"], "output": "out.webm", "how": "ffmpeg's WebM muxer: Vorbis audio alone" }, "exercises": "an audio-only WebM file" },
    { "id": "a-derived-mp3-mka", "section": "a", "derived": { "from": "a-able-paulallen-mp3", "args": ["-map", "0:a", "-t", "60", "-c:a", "copy", "-f", "matroska"], "output": "out.mka", "how": "ffmpeg's Matroska muxer: the MP3 copied into an MKA file" }, "exercises": "a Matroska audio file" },
    { "id": "a-derived-audio-first-webm", "section": "a", "derived": { "from": "a-able-paulallen-mp3", "args": ["-f", "lavfi", "-i", "color=c=gray:s=160x120:r=10", "-map", "0:a", "-map", "1:v", "-t", "20", "-c:a", "libopus", "-b:a", "32k", "-c:v", "libvpx", "-b:v", "50k", "-f", "webm"], "output": "out.webm", "how": "ffmpeg's WebM muxer: an Opus track first, then a VP8 track of a gray picture" }, "exercises": "a WebM video whose first track is audio" },
    { "id": "a-derived-movie-mkv", "section": "a", "derived": { "from": "a-wpt-movie-webm", "args": ["-c", "copy", "-f", "matroska"], "output": "out.mkv", "how": "ffmpeg's Matroska muxer: WPT's movie_5.webm copied into an MKV file" }, "exercises": "a Matroska video file" },

