    {
     "text": " that are larger than the mean have positive "
    },
    {
     "text": "z",
     "italic": true
    },
    {
     "text": "-scores, and values of "
    },
    {
     "text": "x",
     "italic": true
    },
    {
     "text": " that are smaller than the mean have negative "
