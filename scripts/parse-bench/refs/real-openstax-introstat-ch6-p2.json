  },
  {
   "kind": "heading",
   "level": 2,
   "spans": [
    {
     "text": "Z",
     "bold": true,
     "italic": true
    },
    {
     "text": "-Scores",
     "bold": true
    }
   ]
  },
  {
   "kind": "paragraph",
   "spans": [
    {
     "text": "If "
    },
    {
     "text": "X",
     "italic": true
    },
    {
     "text": " is a normally distributed random variable and "
    },
    {
     "text": "X",
     "italic": true
    },
    {
     "text": " ~ "
    },
    {
     "text": "N(μ, σ)",
     "italic": true
