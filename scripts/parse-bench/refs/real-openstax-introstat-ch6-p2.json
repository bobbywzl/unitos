     "text": "6.1 | The Standard Normal Distribution",
     "bold": true
    }
   ]
  },
  {
   "kind": "paragraph",
   "spans": [
    {
     "text": "The "
    },
    {
     "text": "standard normal distribution",
     "bold": true
    },
    {
     "text": " is a normal distribution of "
    },
    {
     "text": "standardized values called ",
     "bold": true
    },
    {
     "text": "z",
     "bold": true,
     "italic": true
    },
    {
     "text": "-scores",
     "bold": true
