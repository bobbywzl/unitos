    {
     "text": ", then the "
    },
    {
     "text": "z",
     "italic": true
    },
    {
     "text": "-score is:"
    }
   ]
  },
  {
   "kind": "equation",
   "latex": "z = \\frac{x - \\mu}{\\sigma}"
  },
  {
   "kind": "paragraph",
   "spans": [
    {
     "text": "The ",
     "bold": true
    },
    {
     "text": "z",
     "bold": true,
     "italic": true
    },
    {
     "text": "-score tells you how many standard deviations the value ",
     "bold": true
    },
    {
     "text": "x",
     "bold": true,
     "italic": true
    },
    {
     "text": " is above (to the right of) or below (to the left of) the mean, ",
     "bold": true
    },
    {
     "text": "μ",
     "bold": true,
     "italic": true
    },
    {
     "text": ".",
     "bold": true
    },
    {
     "text": " Values of "
    },
    {
     "text": "x",
     "italic": true
