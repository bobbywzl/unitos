    {
     "text": "x",
     "italic": true
    },
    {
     "text": " equals the mean, then "
    },
    {
     "text": "x",
     "italic": true
    },
    {
     "text": " has a "
    },
    {
     "text": "z",
     "italic": true
    },
    {
     "text": "-score of zero."
