        {
          "text": "A. Setup",
          "italic": true
        }
      ]
    },
    {
      "kind": "paragraph",
      "spans": [
        {
          "text": "We train all models for 100,000 steps with a batch of 32 articles, a learning rate of "
        },
        {
          "text": "3×10−4",
          "latex": "3\\times 10^{-4}"
        },
        {
          "text": ", and inputs truncated to 16,384 tokens. The window has half-width "
        },
        {
          "text": "w=256",
          "latex": "w=256"
        },
        {
          "text": " and there are 64 global tokens unless stated otherwise."
        }
      ],
