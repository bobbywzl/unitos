      "spans": [
        {
          "text": "V. "
        },
        {
          "text": "CONCLUSION",
          "smallCaps": true
        }
      ],
      "align": "center"
    },
    {
      "kind": "paragraph",
      "spans": [
        {
          "text": "A window of local attention and a few global tokens are enough to read long scientific articles. The pattern is easy to implement, fits in the memory of a single accelerator, and beats dense attention on truncated inputs. Future work will test it on documents with tables and equations, where references across pages are denser still."
        }
      ],
      "align": "justify",
      "indent": "first"
