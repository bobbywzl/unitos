          "text": "Appendix: Definitions"
        }
      ]
    },
    {
      "kind": "paragraph",
      "spans": [
        {
          "text": "On-time delivery",
          "bold": true
        },
        {
          "text": " is the share of parcels delivered by the date promised at the time of shipment."
        }
      ]
    },
    {
      "kind": "paragraph",
      "spans": [
        {
          "text": "Cost per parcel",
          "bold": true
        },
        {
          "text": " is total operating cost, excluding depreciation, divided by the number of parcels delivered."
        }
