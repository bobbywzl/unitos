        {
          "depth": 0,
          "marker": "1.",
          "spans": [
            {
              "text": "Open the temporary sort center in Phoenix by November 3."
            }
          ]
        },
        {
          "depth": 0,
          "marker": "2.",
          "spans": [
            {
              "text": "Hire 140 seasonal drivers, 60 of them for the Southwest."
            }
          ]
        },
        {
          "depth": 0,
          "marker": "3.",
          "spans": [
            {
              "text": "Review the capacity plan weekly from October 20, with daily reviews in December."
            }
          ]
        }
