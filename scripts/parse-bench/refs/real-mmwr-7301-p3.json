   "caption": [
    {
     "bold": true,
     "text": "TABLE 2. Number of topical antifungal prescriptions per provider and prescribing volume among higher-volume"
    },
    {
     "bold": true,
     "text": "*",
     "sup": true
    },
    {
     "bold": true,
     "text": " and lower-volume"
    },
    {
     "bold": true,
     "text": "†",
     "sup": true
    },
    {
     "bold": true,
     "text": " prescribers, by provider type for Medicare Part D beneficiaries — United States, 2021"
    }
   ]
  },
  {
   "kind": "paragraph",
   "spans": [
    {
     "bold": true,
     "text": "Abbreviations:"
    },
    {
     "text": " NP = nurse practitioner; PA = physician assistant."
    }
   ]
  },
