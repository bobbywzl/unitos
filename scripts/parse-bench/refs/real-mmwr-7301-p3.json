    }
   ]
  },
  {
   "kind": "footnote",
   "label": "†",
   "spans": [
    {
     "text": "Bottom 90% of topical antifungal providers, by volume."
    }
   ]
  },
  {
   "kind": "footnote",
   "label": "§",
   "spans": [
    {
     "text": "Column percentage."
    }
   ]
  },
  {
   "kind": "footnote",
