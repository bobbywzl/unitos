{
  "name": "Unitos",
  "short_name": "Unitos",
  "description": "Notes-centric app for deep reading",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f5ead8",
  "theme_color": "#f5ead8",
  "icons": [
    {
      "src": "/icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "/share/target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": ["application/pdf", ".pdf", "audio/*", "video/*"]
        }
      ]
    }
  }
}
