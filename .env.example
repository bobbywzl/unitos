# Database — Supabase Postgres
# DATABASE_URL: pooled connection (Supavisor, port 6543). Used by the app at runtime.
# DIRECT_URL: direct connection (port 5432). Used by Prisma for migrations.
# Both values are in Supabase: Project Settings → Database → Connection string.
# Enable the "vector" extension first: Database → Extensions → vector.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Anthropic API (required for derivations, Phase 4+)
ANTHROPIC_API_KEY=sk-ant-...

# Video transcription (SPEC.md §11) and the voice bubble (SPEC.md §6).
# YouTube videos transcribe via Gemini, then YouTube captions; uploads via
# Whisper, then Gemini. Voice reads text via OpenAI TTS; without the key the
# browser voice reads instead. Set either or both.
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...

# Google sign-in at /signin (set all three; unset = single local reader).
# Redirect URI in the Google Cloud console: <origin>/api/auth/callback.
# SESSION_SECRET: any long random string; APP_URL only if the origin cannot be
# inferred (proxies).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
# APP_URL=https://your-app.vercel.app

# Admin area password (unset = admin login off)
ADMIN_PASSWORD=

# Bearer secret for /api/cron/cleanup (unset = cron endpoint off)
CRON_SECRET=
