# Database — Supabase Postgres
# DATABASE_URL: pooled connection (Supavisor, port 6543). Used by the app at runtime.
# DIRECT_URL: direct connection (port 5432). Used by Prisma for migrations.
# Both values are in Supabase: Project Settings → Database → Connection string.
# Enable the "vector" extension first: Database → Extensions → vector.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# The AI gateway (SPEC.md §2; litellm/README.md): LiteLLM in front of every
# AI provider. With LITELLM_BASE_URL and LITELLM_API_KEY set, every AI call
# but Deepgram's goes through it, the provider keys below live on the
# gateway host, and the app does not read them (DEEPGRAM_API_KEY stays here:
# the media bytes cannot pass through the gateway). LITELLM_ADMIN_KEY is the
# gateway's master key: the admin gateway page (/admin/gateway) reads with it
# and issues the app key.
# LITELLM_BASE_URL=https://your-gateway.up.railway.app
# LITELLM_API_KEY=sk-...
# LITELLM_ADMIN_KEY=sk-...

# The provider keys. Without the gateway, each is read by its client; with
# the gateway, set them on the gateway host instead and delete them here —
# all but DEEPGRAM_API_KEY.
#
# Kimi API (Moonshot AI), required for the AI features without the gateway:
# derivations, the assistant, glossary, and recommended links (GLM 5.3, the
# model most of them run on, is reached through the gateway alone; without
# it Kimi K3 takes every GLM call). With the gateway, Kimi reads the calls
# that carry an image and runs the assistant with Web on. The model is Kimi K3
# (lib/derive/config.ts). MOONSHOT_BASE_URL overrides the endpoint
# (default https://api.moonshot.ai/v1; https://api.moonshot.cn/v1 for an
# account on the China platform).
MOONSHOT_API_KEY=sk-...
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# Anthropic API, required for the import's AI passes — the upload assistant's
# review and instruction check, the URL core and structure passes, Import
# PDF's judgment, and conversion — and for Visualize (Unitos Ultra). The
# model is Claude Fable 5.1 at its highest reasoning effort
# (lib/derive/config.ts). ANTHROPIC_BASE_URL overrides the endpoint (default
# https://api.anthropic.com/v1).
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Translation (SPEC.md §19): DeepL translates a document or transcript into
# the reader's language when the two differ — Chinese and English both ways.
# A Free API key ends in ":fx" (500k characters a month) and uses the free
# host on its own; any other key uses the Pro host. Unset = no Translate offer.
# Jev (TypeSafe AI's System One model, lib/jev.ts): typed decisions behind
# the lead tool of the selection toolbar, Stitch's route and select passes,
# and the nudges a reader has already earned. Unset: those run as before —
# the kind's fixed lead, the GLM reading passes, every nudge.
# Also behind the figure audit's caption check, the sheet header check, the
# URL import's wall check, the digest's ranked cut, the tool checks, the
# History panel's small edits, and a recording's chapters.
# TYPESAFE_BASE_URL is the API root the call posts /systemone under:
# TypeSafe's own (default https://api.typesafe.ai/v1), the QA mock
# (scripts/qa/mock-jev.mjs at http://localhost:3398/v1), or OpenRouter, which
# serves Jev at the same shape — set the three lines below with an OpenRouter
# key. TYPESAFE_MODEL is the model id (jev-latest at TypeSafe;
# typesafe/jev-1.13 at OpenRouter).
TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://openrouter.ai/api/v1
# TYPESAFE_MODEL=typesafe/jev-1.13

DEEPL_API_KEY=

# Video transcription (SPEC.md §11), voice notes, and the voice bubble (SPEC.md §6).
# YouTube videos transcribe from YouTube's own captions (no key), then a
# browser reads the transcript panel (BROWSER_WS_ENDPOINT or CHROMIUM_PATH
# below), then the audio stream takes the upload ladder, then Gemini reads
# the video; when every rung fails the transcript pane offers Paste transcript.
# Uploads transcribe via Deepgram Nova-3 (one call over the whole file, the
# time and the voice of every utterance from the audio itself, $0.26 an
# hour), then Groq Whisper, then OpenAI Whisper, then Gemini. Voice reads
# text via the free Edge voice, no key; OPENAI_API_KEY only adds the OpenAI
# TTS fallback. Set any of the four keys. One attempt can run across
# functions on Vercel; the next leg is a request to this app's own
# transcribe route carrying CRON_SECRET (below), at APP_URL or the
# deployment's VERCEL_URL.
DEEPGRAM_API_KEY=
GROQ_API_KEY=gsk_...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...

# A browser for YouTube transcripts (SPEC.md §11), optional. YouTube bot-checks
# server IPs that ask too often, and a browser on a datacenter IP gets the
# same captcha, so on Vercel set BROWSER_WS_ENDPOINT to a browser service's
# CDP websocket (Browserless, Browserbase, or a Chromium started with
# --remote-debugging-port). Self-hosted, CHROMIUM_PATH points at a Chromium
# binary instead; CHROMIUM_ARGS adds flags, space-separated.
# BROWSER_WS_ENDPOINT=wss://...
# CHROMIUM_PATH=/usr/bin/chromium
# CHROMIUM_ARGS=

# Google sign-in at /signin (set all three; unset = single local reader).
# Redirect URI in the Google Cloud console: <origin>/api/auth/callback.
# SESSION_SECRET: any long random string; APP_URL only if the origin cannot be
# inferred (proxies).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
# APP_URL=https://your-app.vercel.app

# Google Drive upload (SPEC.md §14): "Add from Google Drive" in the document
# bar, picked with the Google Picker. Reuses GOOGLE_CLIENT_ID above. With
# Google sign-in configured, an account links Google Drive on its first pick:
# the consent returns through the sign-in redirect URI above (nothing else to
# register) and the refresh token is stored on the account; picks then need
# no popup. Without sign-in, the browser asks for a token on each use, and for
# that the client's Google Cloud console entry additionally needs this app's
# origin (e.g. https://your-app.vercel.app) under Credentials → the client →
# Authorized JavaScript origins. GOOGLE_PICKER_API_KEY is an optional API key
# restricted to the Picker API (Credentials → Create credentials → API key)
# that improves file previews in the picker.
# GOOGLE_DRIVE_ACCESS picks what every grant asks for. all (default): read
# access to every file the account can read (drive.readonly), so any picked
# file and any pasted Drive link imports. Google calls this scope restricted:
# add it under APIs & Services → OAuth consent screen → Data access; until
# Google verifies the app (brand verification plus a CASA security
# assessment) the consent shows Google's unverified-app warning, and a consent
# screen still in Testing status grants it to its test users only and expires
# the grant after 7 days (the account then links again). picked: the files
# picked in the Google Picker only (drive.file — no verification).
GOOGLE_PICKER_API_KEY=
GOOGLE_DRIVE_ACCESS=all

# Sign in with Apple (optional; any provider opens sign-in).
# APPLE_CLIENT_ID is the Services ID; APPLE_PRIVATE_KEY is the .p8 contents
# (paste with real newlines, or \n-escaped).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Email sign-in through Resend (optional; any provider opens sign-in).
# The form takes a name and an email; the account is created only when the
# confirmation link in the email is clicked. EMAIL_FROM must be a sender on a
# domain verified in Resend. EMAIL_ECHO=1 logs the email instead of sending
# (QA only).
RESEND_API_KEY=
EMAIL_FROM="Unitos <signin@your-domain.com>"

# The beta (TIERS.md): BETA=on gives every account Unitos Ultra in the app
# for as long as it is set: every gate opens and every tier mark is the
# black diamond, whatever the account's record says. Billing (SPEC.md §24)
# keeps selling the tiers and recording purchases; a purchase takes effect
# in the app when BETA is unset. Unset it and redeploy to end the beta.
BETA=

# Admin area password (unset = admin login off)
ADMIN_PASSWORD=

# Bearer secret for /api/cron/cleanup and /api/cron/models (unset = the cron
# endpoints are off). vercel.json schedules cleanup daily and the model
# update on the 1st of every second month.
CRON_SECRET=

# Billing (SPEC.md §24): Unitos Premium and Unitos Ultra sold through Stripe
# as subscriptions, monthly or yearly. STRIPE_SECRET_KEY opens the Stripe
# client: use a restricted key (rk_...) with only the permissions the
# integration uses (Checkout Sessions write, Customers write, Customer portal
# write, Subscriptions read, Invoices read, Prices read; a 403 in the Stripe
# log names a missing one), one key per environment, never a live key in a
# committed file. STRIPE_WEBHOOK_SECRET is the signing secret of the webhook
# endpoint <origin>/api/stripe/webhook (register it in Stripe with the
# events checkout.session.completed,
# checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, invoice.paid,
# invoice.payment_failed, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted, and
# charge.refunded); the four STRIPE_PRICE_* variables are the ids of the
# recurring Stripe prices each tier sells at, one per tier per interval:
# one Stripe product per tier, two prices on it. Setting these turns
# nothing on: the billing pages under /billing and the links to them in the
# app stay hidden until the admin billing page (/admin/billing) turns
# billing on, and that needs all six set and all four prices readable.
# STRIPE_TAX="on" makes checkout calculate tax with Stripe Tax and collect
# the billing address and a tax id; every renewal invoice then carries tax.
# Leave it unset until Stripe Tax is active on the account with a head
# office address, a tax code on each product, and a registration in every
# jurisdiction that collects: without a registration Stripe collects no tax
# and reports no error.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_PRICE_ULTRA_MONTHLY=
STRIPE_PRICE_ULTRA_YEARLY=
STRIPE_TAX=
