# The gateway host's environment. Copy to litellm/.env for a local run
# (docker compose up litellm); set the same names on Railway, Fly, or Render.

# Any long random string: the master key. The app's host gets it as
# LITELLM_ADMIN_KEY; the admin console's gateway page reads with it and
# issues the app key.
LITELLM_MASTER_KEY=sk-change-me
# Encrypts what the gateway stores in its database. Any long random string;
# never change it once set.
LITELLM_SALT_KEY=change-me-too
# The gateway's own Postgres: spend logs, keys, limits.
DATABASE_URL=postgresql://postgres:postgres@litellm-db:5432/litellm

# The provider keys. These live here and nowhere else. Deepgram's is not
# among them: the app calls Deepgram directly (litellm/README.md).
ZAI_API_KEY=
MOONSHOT_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
DEEPL_API_KEY=
# Jev (lib/jev.ts): an OpenRouter key, since the /typesafe pass-through in
# config.yaml targets OpenRouter; a TypeSafe key with the target changed.
TYPESAFE_API_KEY=
