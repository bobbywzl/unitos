# Local quickstart. Copy to .env after `docker compose up -d`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dissect"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/dissect"

# AI features (Explain, Simplify, Salience, Extract, assistant, glossary) are off
# without this. Everything else works.
# MOONSHOT_API_KEY=sk-...

# Google sign-in at /signin (set all three; unset = single local reader).
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# SESSION_SECRET=...

# Google Drive upload ("Add from Google Drive" in the document bar). Reuses
# GOOGLE_CLIENT_ID above; see .env.example for the Google Cloud console setup.
# GOOGLE_PICKER_API_KEY=...

# Video transcription: YouTube via YouTube's own captions (no key), then
# Gemini; uploads via Groq Whisper, then OpenAI Whisper, then Gemini. Set any.
# GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...

# /admin login.
# ADMIN_PASSWORD=
