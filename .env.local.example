# Local quickstart. Copy to .env after `docker compose up -d`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dissect"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/dissect"

# AI features (Explain, Simplify, Salience, Extract, assistant, glossary) are off
# without this. Everything else works.
# ANTHROPIC_API_KEY=sk-ant-...

# Corpus search embeddings.
# VOYAGE_API_KEY=pa-...

# /admin login.
# ADMIN_PASSWORD=
