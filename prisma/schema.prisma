generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

model Notebook {
  id        String             @id @default(cuid())
  title     String
  profile   Json? // ReaderProfile override for this notebook
  sections  Section[]
  documents NotebookDocument[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model Section {
  id         String    @id @default(cuid())
  notebookId String
  notebook   Notebook  @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  title      String
  order      Int
  hidden     Boolean   @default(false) // Annotations section: searchable, not shown in the outline
  parentId   String? // nesting, one level deep is enough for v1
  parent     Section?  @relation("SectionNesting", fields: [parentId], references: [id])
  children   Section[] @relation("SectionNesting")
  notes      Note[]
}

model Note {
  id             String                       @id @default(cuid())
  sectionId      String
  section        Section                      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  content        String // markdown
  status         NoteStatus                   @default(ACCEPTED) // manual notes are ACCEPTED on create
  derivationType DerivationType? // null = manually written
  color          String? // manual highlight hue: "clay" | "sage" | "gold"
  order          Int
  sources        Source[]
  embedding      Unsupported("vector(1024)")? // pgvector, Phase 6
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
}

enum NoteStatus {
  PENDING // AI-proposed, awaiting user decision
  ACCEPTED
  REJECTED // keep for 7 days for undo, then hard-delete via cron
}

enum DerivationType {
  EXPLAIN
  SIMPLIFY
  SALIENCE
  EXTRACT // legacy notes only; the tool became DISTILL
  SUMMARIZE // document-level summary, one per depth
  SYNTHESIS // notebook-scope assistant output
  FIND // video content reader: query → time ranges + explanations (SPEC.md §11)
  DISTILL // question → the quotes that answer it, stored on the attachment (SPEC.md §4)
}

model Source {
  id          String   @id @default(cuid())
  noteId      String
  note        Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  documentId  String
  document    Document @relation(fields: [documentId], references: [id])
  // Anchor: dual strategy (see SPEC.md §5)
  blockId     String
  startOffset Int
  endOffset   Int
  quotedText  String
  prefix      String // 32 chars before selection
  suffix      String // 32 chars after selection
  orphaned    Boolean  @default(false)
  // Video anchor (SPEC.md §11): a time range instead of a text span. When
  // startTime is set the anchor skips the text ladder and never orphans —
  // the video file never changes.
  startTime   Float?
  endTime     Float?
  region      Json? // drawn shape in percent coordinates: {kind: "ellipse", cx, cy, rx, ry}
}

model Document {
  id            String             @id @default(cuid())
  title         String
  font          String? // reader body font: null = default, "serif", "mono"
  parserVersion Int                @default(0) // parse pipeline version; stale URL documents re-parse automatically
  sourceUrl     String?
  fileHash      String?            @unique // dedupe re-uploads
  fileData      Bytes? // original PDF bytes, kept for forced re-parse (SPEC.md §8 Phase 3)
  blocks        Block[]
  notebooks     NotebookDocument[]
  sources       Source[]
  edits         BlockEdit[]
  linksFrom     DocLink[]          @relation("DocLinkFrom")
  linksTo       DocLink[]          @relation("DocLinkTo")
  glossary      Json? // Phase 7: [{term, definition, blockIds[]}]
  references    Json? // the article's reference list, extracted at ingest: [{id, label, text, url}]
  video         VideoAsset? // set = video document; the reader renders the video pane (SPEC.md §11)
  createdAt     DateTime           @default(now())
}

// One row per user change to a document: block text edits and link add/remove.
// The Edits panel renders these newest-first; TEXT_EDIT rows can revert.
model BlockEdit {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  blockId    String?
  kind       String // "TEXT_EDIT" | "LINK_ADD" | "LINK_REMOVE"
  before     String?
  after      String?
  meta       Json? // link events: { linkId, toDocumentId, toTitle, quotedText }
  createdAt  DateTime @default(now())

  @@index([documentId, createdAt])
}

// A hyperlink from a text range in one document to another document.
// The anchor uses the same dual strategy as Source (SPEC.md §5), so links
// heal across re-parses and text edits the same way note anchors do.
model DocLink {
  id             String   @id @default(cuid())
  fromDocumentId String
  fromDocument   Document @relation("DocLinkFrom", fields: [fromDocumentId], references: [id], onDelete: Cascade)
  fromBlockId    String
  startOffset    Int
  endOffset      Int
  quotedText     String
  prefix         String
  suffix         String
  toDocumentId   String
  toDocument     Document @relation("DocLinkTo", fields: [toDocumentId], references: [id], onDelete: Cascade)
  // The other end: a text range in the target document, so a link connects a
  // quote to a quote. Null = legacy document-level link.
  toBlockId      String?
  toStartOffset  Int?
  toEndOffset    Int?
  toQuotedText   String?
  toPrefix       String?
  toSuffix       String?
  // Link ends orphan visibly, like Source anchors (SPEC.md §5).
  fromOrphaned   Boolean  @default(false)
  toOrphaned     Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([fromDocumentId])
  @@index([toDocumentId])
}

model NotebookDocument {
  notebookId String
  documentId String
  notebook   Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id])
  salience      Json? // SALIENCE layer: [{blockId, start, end}], per notebook per document (SPEC.md §4)
  summaries     Json? // SUMMARIZE output: {layman?, intermediate?, professional?}, per notebook per document (SPEC.md §4)
  distillations Json? // DISTILL output: [{id, question, createdAt, quotes}], newest first, per notebook per document (SPEC.md §4)

  @@id([notebookId, documentId])
}

model Block {
  id           String    @id @default(cuid())
  documentId   String
  document     Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  order        Int
  type         BlockType
  text         String // plain text content
  originalText String? // as first parsed; null = text is unedited. "" = user-authored block.
  html         String? // rendered content for figures/tables
  styles       Json? // inline decoration spans: [{start, end, style: "bold"|"italic"|"underline"|"code", quotedText}]
  citations    Json? // in-text citation spans: [{start, end, refId, quotedText}], refId → Document.references
  // TRANSCRIPT blocks: seconds into the video (SPEC.md §11).
  startTime    Float?
  endTime      Float?
  links        Json? // link spans: [{start, end, quotedText, targetOrder?, href?}] — Contents entries and PDF hyperlinks
}

enum BlockType {
  PARAGRAPH
  HEADING
  FIGURE
  TABLE
  EQUATION
  LIST
  CODE
  SEPARATOR
  VIDEO // the video document's player block, exactly one per video document
  TRANSCRIPT // one transcript line, timed with startTime/endTime
}

// The video of a video document (SPEC.md §11). kind UPLOAD: bytes in
// VideoChunk rows, streamed with HTTP Range support by /api/video/[documentId];
// mimeType/size/chunkSize set. kind YOUTUBE: plays through the YouTube IFrame
// player; youtubeId set, no bytes stored.
model VideoAsset {
  id                  String           @id @default(cuid())
  documentId          String           @unique
  document            Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  kind                VideoKind        @default(UPLOAD)
  youtubeId           String?          @unique // kind YOUTUBE only; dedupes re-adds
  mimeType            String? // kind UPLOAD only
  size                Int? // kind UPLOAD only
  chunkSize           Int? // kind UPLOAD only
  duration            Float? // seconds; written by the client after metadata loads
  width               Int?
  height              Int?
  transcriptStatus    TranscriptStatus @default(NONE)
  transcriptError     String? // FAILED only: the reason, shown in the transcript pane
  // When the running transcription started. A PENDING older than 10 minutes is
  // a dead run and may start again.
  transcriptStartedAt DateTime?
  chunks              VideoChunk[]
  createdAt           DateTime         @default(now())
}

enum VideoKind {
  UPLOAD
  YOUTUBE
}

model VideoChunk {
  id      String     @id @default(cuid())
  videoId String
  video   VideoAsset @relation(fields: [videoId], references: [id], onDelete: Cascade)
  index   Int
  data    Bytes

  @@unique([videoId, index])
}

enum TranscriptStatus {
  NONE
  PENDING
  READY
  FAILED
}

// Staging for PDF uploads larger than one request. Vercel caps a request body
// at about 4.5 MB, so the client splits big files into chunks (/api/uploads);
// /api/uploads/complete assembles them, runs normal ingest, and deletes the rows.
model UploadChunk {
  id        String   @id @default(cuid())
  uploadId  String
  index     Int
  data      Bytes
  createdAt DateTime @default(now())

  @@unique([uploadId, index])
  @@index([createdAt])
}

model Feedback {
  id        String   @id @default(cuid())
  category  String // "bug" | "idea" | "other"
  message   String
  page      String? // pathname where it was filed
  userAgent String?
  status    String   @default("new") // "new" | "seen" | "resolved"
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

model ReaderProfile {
  id          String @id @default(cuid())
  userId      String @unique // constant in v1
  background  String // "Stanford student, stochastic calc + stats + quantum"
  purpose     String // "due diligence" | "exam prep" | "replicate results" | free text
  application String // "investment decision for Bough Capital" etc.
}
