generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

// One reader account (SPEC.md §2). Rows exist only when Google sign-in is
// configured; with sign-in off the app runs as the implicit local reader
// ("user-1") and owner columns keep that id. The first account to sign in
// adopts the local reader's data.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  picture      String    @default("")
  // Collaboration label: the symbol and color that mark this account's notes and
  // edits on shared corpora. "" = defaults (first letter of name; color from id).
  symbol       String    @default("")
  color        String    @default("")
  passwordHash String    @default("") // "" = no password (OAuth or link-only); scrypt "s1$salt$hash"
  // The account's tier (TIERS.md): Unitos Premium or Unitos Ultra. No
  // billing yet — the operator sets it on the account.
  tier         Tier      @default(PREMIUM)
  // When the account's Premium trial ends (TIERS.md): a new account gets
  // Unitos Premium free for TRIAL_MONTHS (lib/tiers.ts). Null = no end: the
  // operator granted the tier. Past this date, on PREMIUM, the account is
  // expired: Premium features gate until the operator extends or grants.
  trialEndsAt  DateTime?
  // Linked Google Drive (SPEC.md §14): the refresh token from the Drive code
  // flow, and the scope Google granted with it (drive.readonly = all files;
  // drive.file = picked files only). "" = not linked; the picker then asks
  // per visit.
  driveRefreshToken String @default("")
  driveScope        String @default("")
  // Billing (SPEC.md §24): the account's Stripe customer, and the
  // subscription that pays for its tier. "" = none. subscriptionTier is the
  // tier the subscription buys; subscriptionEndsAt is the paid period's end.
  // The gates still read tier and trialEndsAt only: the webhook writes them.
  stripeCustomerId   String    @default("")
  subscriptionId     String    @default("")
  subscriptionTier   Tier?
  subscriptionEndsAt DateTime?
  // The account's active time in the app, in seconds (lib/active-time.ts): the
  // tab visible and the reader acting in it. The billing ask (SPEC.md §24)
  // opens once it passes ASK_AFTER_SECONDS; billingAskedAt is when the ask
  // last opened, so it waits ASK_AGAIN_MS before opening again.
  activeSeconds  Int       @default(0)
  billingAskedAt DateTime?
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  sessions     Session[]
  purchases    Purchase[]
  linkScanRuns LinkScanRun[]
}

// Billing (SPEC.md §24): one purchase per paid Stripe invoice — the first
// payment of a subscription and every renewal. The receipt page shows one
// row; the receipts page lists the account's rows.
model Purchase {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier            Tier
  stripeInvoiceId String         @unique
  subscriptionId  String         @default("")
  // Stripe's invoice number, e.g. "A1B2C3D4-0001"; "" when Stripe gave none.
  number          String         @default("")
  // Minor units (cents) and the ISO currency code, as Stripe reports them.
  amount          Int
  currency        String
  status          PurchaseStatus @default(PAID)
  // The paid period.
  periodStart     DateTime
  periodEnd       DateTime
  // Stripe's hosted invoice page and PDF; "" when Stripe gave none.
  hostedInvoiceUrl String        @default("")
  invoicePdfUrl    String        @default("")
  paidAt          DateTime
  createdAt       DateTime       @default(now())

  @@index([userId, paidAt])
}

enum PurchaseStatus {
  PAID
  REFUNDED
}

// One operator setting per row (lib/settings.ts). Billing's switch is the
// row "billing": "on" or "off"; no row = off.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// The tiers (TIERS.md): every account is Premium (on trial or granted) or
// Ultra. There is no free tier.
enum Tier {
  PREMIUM
  ULTRA
}

// One sign-in session: random token in an httpOnly cookie, 30 days.
model Session {
  token     String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

// Email sign-in: one pending confirmation per email and purpose. purpose
// "signup" creates the account when the link is clicked; purpose "reset" sets
// a new password. A row is single-use (deleted on confirm) and expires after
// 30 minutes. Only the token's SHA-256 is stored.
model EmailConfirmation {
  id        String   @id @default(cuid())
  email     String
  name      String   @default("")
  purpose   String   @default("signup") // "signup" | "reset"
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// The block list (SPEC.md §2): one row per blocked email. A blocked email
// cannot sign in through any provider and cannot start an email sign-in or a
// password reset; blocking deletes the account's sessions, so it is signed out
// at once. The row keys on the email, not the account, so an email with no
// account yet can be blocked, and a reset account stays blocked. The operator
// blocks and unblocks from the admin accounts page.
model BlockedEmail {
  email     String   @id
  createdAt DateTime @default(now())
}

model Notebook {
  id            String                 @id @default(cuid())
  userId        String                 @default("user-1") // owner account; "user-1" = the local reader
  title         String
  profile       Json? // ReaderProfile override for this notebook
  // Change counter for live sync: every write to the corpus or its documents
  // increments it; open workspaces poll it and refresh when it moves.
  rev           Int                    @default(0)
  // Corpus-scope DISTILL output (SPEC.md §13): [{id, question, createdAt,
  // createdById, quotes}], newest first; each quote carries its documentId.
  distillations Json?
  sections      Section[]
  documents     NotebookDocument[]
  folders       DocumentFolder[]
  digest        NotebookDigest?
  collaborators NotebookCollaborator[]
  presence      NotebookPresence[]
  events        NotebookEvent[]
  linkScanRuns  LinkScanRun[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([userId])
}

// One person a corpus is shared with. Keyed by email (accounts key on the
// email, SPEC.md §2), so an invite works before the account exists. The owner
// is Notebook.userId, never a row here. Role EDITOR writes like the owner;
// VIEWER reads only.
model NotebookCollaborator {
  id         String     @id @default(cuid())
  notebookId String
  notebook   Notebook   @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  email      String // lowercase
  role       CollabRole @default(EDITOR)
  addedById  String? // account that shared it
  createdAt  DateTime   @default(now())

  @@unique([notebookId, email])
  @@index([email])
}

enum CollabRole {
  EDITOR
  VIEWER
}

// One corpus-level action for the History panel: content deletions and
// detachments that no BlockEdit row covers. Document edits stay in BlockEdit;
// the panel merges both, newest first, with the author on every entry.
model NotebookEvent {
  id         String   @id @default(cuid())
  notebookId String
  notebook   Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  userId     String? // account that did it; null = before attribution existed
  kind       String // "NOTE_REMOVE" | "SECTION_REMOVE" | "DOCUMENT_DETACH"
  content    String // snapshot: the removed note's text, the section or document title
  meta       Json? // NOTE_REMOVE: { sectionTitle }; SECTION_REMOVE: { noteCount }
  createdAt  DateTime @default(now())

  @@index([notebookId, createdAt])
}

// Who has a corpus open right now: one row per corpus per account, stamped by
// the sync poll. A row older than 25 seconds reads as gone; the daily cron
// deletes stale rows.
model NotebookPresence {
  id         String   @id @default(cuid())
  notebookId String
  notebook   Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  userId     String
  documentId String? // the open document; null = the notes full page
  lastSeenAt DateTime @default(now())

  @@unique([notebookId, userId])
  @@index([lastSeenAt])
}

// The digest: the stored context the assistant reads (SPEC.md §7). One row per
// corpus per user holding the whole corpus, serialized: every document (text
// and transcript), note, annotation, distillation, extraction, summary,
// salience span, link, and edit. fingerprint is cheap aggregates over the
// content tables; a mismatch rebuilds the row on read. The admin digest page
// (/admin/digest) shows the store and rebuilds on demand.
model NotebookDigest {
  id          String   @id @default(cuid())
  notebookId  String   @unique
  notebook    Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  userId      String // per-user store; constant in v1 (SPEC.md §2)
  fingerprint String
  parts       Json // DigestParts (src/lib/digest/types.ts)
  counts      Json // DigestCounts: documents, notes, annotations, distillations, …
  chars       Int // rendered size before budget cuts
  builtAt     DateTime @default(now())

  @@index([userId])
}

model Section {
  id         String    @id @default(cuid())
  notebookId String
  notebook   Notebook  @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  title      String
  order      Int
  hidden     Boolean   @default(false) // Annotations section: searchable, not shown in the outline
  parentId   String? // nesting, one level deep is enough for v1
  parent     Section?  @relation("SectionNesting", fields: [parentId], references: [id])
  children   Section[] @relation("SectionNesting")
  notes      Note[]

  @@index([notebookId])
}

model Note {
  id             String          @id @default(cuid())
  sectionId      String
  section        Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  content        String // markdown
  gist           String? // the phrase a collapsed row shows, written by AI to fit the row (SPEC.md §6); null until written, cleared when content changes
  status         NoteStatus      @default(ACCEPTED) // manual notes are ACCEPTED on create
  derivationType DerivationType? // null = manually written
  color          String? // manual highlight hue: "clay" | "sage" | "gold"
  // The conversation continued from an AI tool's output — Explain+, Simplify+,
  // Analyze+, Visualize+ (SPEC.md §21): [{role: "user" | "assistant", content}],
  // oldest first. Null = the tool's output alone. An assistant conversation
  // (SYNTHESIS) keeps its transcript in content instead.
  conversation   Json?
  // The condensed log of the conversation (SPEC.md §21): {turns, lines:
  // [{role, text}]}, one line per message, written by AI when the reader
  // hovers the mark; stale when turns no longer matches the conversation.
  log            Json?
  pinned         Boolean         @default(false) // pinning also moves the note to the top of its section
  order          Int
  // A side chat (SPEC.md §7): a conversation branched off a quote of an
  // assistant answer. It belongs to the conversation it was started from,
  // opens from that chat box alone, and never shows in assistant history.
  // The quote is the words it started from. Null = an ordinary note.
  sideChatOfId   String?
  sideChatOf     Note?           @relation("SideChats", fields: [sideChatOfId], references: [id], onDelete: Cascade)
  sideChats      Note[]          @relation("SideChats")
  sideChatQuote  String?
  // Account that wrote the note (or ran the derivation that produced it).
  // Soft reference like Notebook.userId; null = before attribution existed.
  createdById    String?
  // A resolved comment (SPEC.md §29): the account that resolved it; null =
  // open. It paints no mark and lists under Resolved in the Annotations tab.
  resolvedById   String?
  // The document the note was written in (SPEC.md §6): the open document
  // when the note was typed in the tray, spoken in it, or made from a
  // passage. The notes tray lists the open document's notes — those written
  // in it and those that quote it — and the notes full page's By document
  // view puts each note under its document. Null = the note belongs to the
  // project as a whole: written on the notes full page, or before the field
  // existed and citing nothing.
  documentId     String?
  document       Document?       @relation(fields: [documentId], references: [id], onDelete: SetNull)
  sources        Source[]
  replies        Reply[]
  edits          NoteEdit[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([sectionId])
  @@index([sideChatOfId])
  @@index([documentId])
}

// One edit of a note's text, for the note's own history (SPEC.md §12): who
// changed the note, when, and the text after the change. A save within ten
// minutes of the same person's last edit updates that edit instead of adding
// one, so one sitting is one entry (lib/notes/edits.ts).
model NoteEdit {
  id        String   @id @default(cuid())
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  userId    String? // account that edited; null = the local reader
  content   String // the note's text after this edit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([noteId, createdAt])
}

// One reply in the discussion under a note (notes and annotations alike),
// under one edit in the Edits panel, or under one link — how collaborators
// comment on each other's work. Threads are flat, oldest first. Exactly one
// of noteId, blockEditId, and docLinkId is set.
model Reply {
  id          String     @id @default(cuid())
  noteId      String?
  note        Note?      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  blockEditId String?
  blockEdit   BlockEdit? @relation(fields: [blockEditId], references: [id], onDelete: Cascade)
  docLinkId   String?
  docLink     DocLink?   @relation(fields: [docLinkId], references: [id], onDelete: Cascade)
  userId      String // account that wrote the reply
  content     String
  resolvedById String? // account that resolved it; null = open
  createdAt   DateTime   @default(now())

  @@index([noteId])
  @@index([blockEditId])
  @@index([docLinkId])
}

enum NoteStatus {
  PENDING // AI-proposed, awaiting user decision
  ACCEPTED
  REJECTED // keep for 7 days for undo, then hard-delete via cron
}

enum DerivationType {
  EXPLAIN
  SIMPLIFY
  SALIENCE
  EXTRACT // the reader's Match-it: origin phrase → the passages that reveal its topic, stored on the attachment (SPEC.md §4)
  SUMMARIZE // document-level summary, one per depth
  SYNTHESIS // notebook-scope assistant output
  FIND // video content reader: query → time ranges + explanations (SPEC.md §11)
  DISTILL // the reader's Extract: question → the quotes that answer it, stored on the attachment (SPEC.md §4)
  FORMALIZE // transcript → formal article on the attachment, or bullet-point notes (PENDING)
  ASK // a question about a time range of a video or audio document, answered from the transcript in that range; "Add to notes" lands PENDING (SPEC.md §11)
  COMPARE // two documents → one PENDING note of agreements, disagreements, and what only one covers, sourced on both (SPEC.md §4)
  ANALYZE // a figure or table read by the vision model: values verbatim, estimates marked; one PENDING note on the block (SPEC.md §4)
  VOICE // a spoken note: transcribed, cleaned, landed PENDING for the reader to accept (SPEC.md §6)
  VISUALIZE // Unitos Ultra: the selection as a picture — a diagram, a drawing, or a short animation — stored as an SVG ImageAsset and one annotation on the selection; declined when the model is not certain the picture is faithful (SPEC.md §20)
  DEFINE // one word → its meaning in its sentence, streamed into the toolbar under the Define row; persists nothing (SPEC.md §4)
}

// One press of Recommend links (SPEC.md §13): the project-wide scan the
// reader asks for. The rows are the monthly quota — an account gets a few
// runs a calendar month, and the scan reads every document of a project
// whole, so it never starts on its own.
model LinkScanRun {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notebookId String
  notebook   Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  linkCount  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

model Source {
  id          String   @id @default(cuid())
  noteId      String
  note        Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  documentId  String
  document    Document @relation(fields: [documentId], references: [id])
  // Anchor: dual strategy (see SPEC.md §5)
  blockId     String
  startOffset Int
  endOffset   Int
  quotedText  String // the words as quoted when the source was made; a block edit never changes it (SPEC.md §5)
  // The words the anchor covers now, once a block edit changed them; null
  // while they are still the quote. The ladder re-finds by these.
  anchoredText String?
  prefix      String // 32 chars before selection
  suffix      String // 32 chars after selection
  orphaned    Boolean  @default(false)
  // The layer the anchor points into (SPEC.md §28): null for the block's
  // text, "core" for the block's core in the collapsed view. A core anchor's
  // offsets and quote are the core's words; it heals against the core.
  layer       String?
  // Video anchor (SPEC.md §11): a time range instead of a text span. When
  // startTime is set the anchor skips the text ladder and never orphans —
  // the video file never changes.
  startTime   Float?
  endTime     Float?
  // Drawn shape in percent coordinates: {kind: "path", points} or
  // {kind: "ellipse", cx, cy, rx, ry}. On a video anchor it marks a spot on
  // the frame; on a PAGE block it is a page anchor (SPEC.md §16) — offsets
  // 0/0, the text ladder skipped, orphaned only if the PAGE block is gone.
  region      Json?

  @@index([documentId])
  @@index([noteId])
}

// One block's translation into one language (SPEC.md §19): DeepL output,
// cached so a document translates once. sourceHash is the SHA-256 of the
// block text it was made from; a block edited since reads as stale and
// translates again on the next Translate.
model BlockTranslation {
  id         String   @id @default(cuid())
  blockId    String
  lang       String // target: "en" | "zh"
  sourceHash String
  text       String
  createdAt  DateTime @default(now())

  @@unique([blockId, lang])
}

// An image dropped into a note or into the reader's edit mode (SPEC.md §16).
// The bytes live here and the reader loads them from /api/images/[imageId];
// a note points at that URL in its markdown, a FIGURE block in its html.
model ImageAsset {
  id         String    @id @default(cuid())
  mimeType   String
  size       Int
  data       Bytes
  // Account that added it; null = the local reader (sign-in off).
  userId     String?
  // The document whose parse captured it (a chart animation's loop,
  // lib/parse/capture-animation.ts): it goes with the document, and a
  // re-parse replaces it. Null = an image the reader dropped.
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@index([documentId])
}

model Document {
  id            String             @id @default(cuid())
  title         String
  font          String? // reader body font: null = default, "serif", "mono"
  // The page's text column width in px (lib/parse/figure-style.ts): the
  // reader's column width for a URL document. Null = the reader's default.
  columnWidth   Int?
  // The browser render for scripted figures (lib/parse/render-page.ts): when
  // the last one ran for this document, and why it did not deliver (null =
  // it did). Both null with a caption left without its figure: the reader
  // runs one on open where a browser is configured (SPEC.md §15).
  figureRenderAt    DateTime?
  figureRenderError String?
  parserVersion Int                @default(0) // parse pipeline version; stale URL documents re-parse automatically
  sourceUrl     String?
  fileHash      String?            @unique // dedupe re-uploads
  fileData      Bytes? // original PDF bytes, kept for forced re-parse (SPEC.md §8 Phase 3)
  // The stored file's format when it is neither a PDF nor a Markdown file
  // (SPEC.md §27): "slides" (a .pptx) or "sheets" (a .xlsx, .csv, or .tsv).
  // Null = a PDF, a Markdown file, or no file. Re-parse reads it to pick
  // the parser; the reader reads it to lay the document out.
  format        String?
  // Handwritten document (SPEC.md §16): the PDF is rough handwritten notes or
  // drawings. PAGE blocks render its pages; conversion writes text blocks
  // after them. Import PDF sets it by AI judgment; the document menu flips it.
  handwritten         Boolean          @default(false)
  conversionStatus    ConversionStatus @default(NONE)
  conversionError     String? // FAILED only: the reason, shown under the pages
  // When the running conversion started. A PENDING older than 10 minutes is
  // a dead run and may start again.
  conversionStartedAt DateTime?
  // When the running re-parse started (/api/documents/[documentId]/reparse).
  // A second re-parse of the same document waits while one is running; a
  // start older than the route's time budget is a dead run and may start
  // again.
  reparseStartedAt    DateTime?
  blocks        Block[]
  notebooks     NotebookDocument[]
  sources       Source[]
  notes         Note[] // the notes written in this document (Note.documentId)
  edits         BlockEdit[]
  linksFrom     DocLink[]          @relation("DocLinkFrom")
  linksTo       DocLink[]          @relation("DocLinkTo")
  glossary      Json? // Phase 7: [{term, definition, blockIds[], lang, definitions: {en?, zh?}}] — one definition per reader language
  // The contents (SPEC.md §26): the document's parts, each with the block it
  // starts at — [{title, blockId, level, lang}]. Built when the reader first
  // opens Contents, never at ingest.
  contents      Json?
  // The skeleton (SPEC.md §22): the document collapsed for Stitch — a gist,
  // one summary per part of the contents, one line per block, each line
  // with the hash of the block it stands for — {v, gist, parts, lines,
  // chars}. Built in the background after an add, rebuilt when more than a
  // tenth of the text has changed. skeletonStartedAt: when the running
  // build started; a start older than 10 minutes is a dead run.
  skeleton          Json?
  skeletonStartedAt DateTime?
  // Collapse (SPEC.md §28): every block's core — what the block really
  // says, in plain words, at a tenth to a third of its length, written in
  // the light of the whole document — {v, cores: [{blockId, hash, text}]},
  // each core with the hash of the block text it was written from. Built
  // when the reader presses Collapse, for the blocks with no current core.
  collapse          Json?
  references    Json? // the article's reference list, extracted at ingest: [{id, label, text, url}]
  video         VideoAsset? // set = video document; the reader renders the video pane (SPEC.md §11)
  images        ImageAsset[] // images the parse captured (chart animations)
  readingPositions ReadingPosition[]
  // A generated document (SPEC.md §22): Stitch wrote it from the project's
  // documents. generatedCommand is the command that made it; a document with
  // one is a generated document of the project it is attached to.
  generatedCommand String?
  // A blank document (SPEC.md §29): the rich text the reader writes in the
  // page editor — Tiptap (ProseMirror) JSON, the source of truth for its
  // words and formatting. The document's Block rows are the paragraph index
  // derived from it on every save (lib/docs/sync.ts), so anchors, notes, and
  // every AI tool keep reading blocks. Null for every other document.
  richText      Json?
  // Bumped by every save of richText: a save names the revision it started
  // from, and a save from an older one is refused (a conflict, not a loss).
  richTextRev   Int                @default(0)
  // The page setup of a blank document: {pageless, width, height, margins:
  // {top, right, bottom, left}, color} in points. Null = Letter, 1 in
  // margins, pages.
  pageSetup     Json?
  // When the rich text was last saved, and by whom: a save 10 minutes or
  // more after the last one starts a new sitting (lib/docs/versions.ts).
  richTextSavedAt DateTime?
  richTextSavedBy String?
  versions      DocumentVersion[]
  createdAt     DateTime           @default(now())
}

// A version of a blank document (SPEC.md §29): its rich text as a sitting of
// edits left it, kept when the next sitting starts, or named at once (Name
// current version). Every version is kept; one per revision.
model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  rev        Int // the Document.richTextRev it holds
  richText   Json
  userId     String? // the account that saved it last; no relation, as BlockEdit.userId
  name       String? // Name this version; null = unnamed
  savedAt    DateTime
  createdAt  DateTime @default(now())

  @@unique([documentId, rev])
}

// The reading position an account left in a document (SPEC.md §6,
// lib/reading-position.ts): the block at the reading line when it last read
// there, the offset from the line to the block's top (negative = the line
// cut into the block), the block's height then (another screen scales the
// offset), and when the reader was there, by the reading browser's clock.
// One row per account per document; a save replaces the row only when it is
// newer. The reader opens the document there and draws the left-off mark
// above the block. userId is a soft reference like Notebook.userId ("user-1"
// = the local reader).
model ReadingPosition {
  userId     String
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  blockId    String
  offset     Float
  height     Float
  at         DateTime

  @@id([userId, documentId])
  @@index([documentId])
}

// One row per user change to a document: block text edits and link add/remove.
// The Edits panel renders these newest-first; TEXT_EDIT rows can revert.
model BlockEdit {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  blockId    String?
  kind       String // "TEXT_EDIT" | "LINK_ADD" | "LINK_REMOVE"
  before     String?
  after      String?
  meta       Json? // link events: { linkId, toDocumentId, toTitle, quotedText }
  userId     String? // account that made the edit; null = before attribution existed
  replies    Reply[]
  createdAt  DateTime @default(now())

  @@index([documentId, createdAt])
}

// A hyperlink from a text range in one document to another document.
// The anchor uses the same dual strategy as Source (SPEC.md §5), so links
// heal across re-parses and text edits the same way note anchors do.
// recommended = AI-proposed on ingest (SPEC.md §13), awaiting Accept in the
// Annotations panel; reason says why the AI connected the two passages.
model DocLink {
  id             String   @id @default(cuid())
  recommended    Boolean  @default(false)
  reason         String?
  createdById    String? // account that made the link, or triggered the scan
  replies        Reply[]
  fromDocumentId String
  fromDocument   Document @relation("DocLinkFrom", fields: [fromDocumentId], references: [id], onDelete: Cascade)
  fromBlockId    String
  startOffset    Int
  endOffset      Int
  quotedText     String
  prefix         String
  suffix         String
  toDocumentId   String
  toDocument     Document @relation("DocLinkTo", fields: [toDocumentId], references: [id], onDelete: Cascade)
  // The other end: a text range in the target document, so a link connects a
  // quote to a quote. Null = legacy document-level link.
  toBlockId      String?
  toStartOffset  Int?
  toEndOffset    Int?
  toQuotedText   String?
  toPrefix       String?
  toSuffix       String?
  // Link ends orphan visibly, like Source anchors (SPEC.md §5).
  fromOrphaned   Boolean  @default(false)
  toOrphaned     Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([fromDocumentId])
  @@index([toDocumentId])
}

model NotebookDocument {
  notebookId String
  documentId String
  notebook   Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id])
  salience      Json? // SALIENCE layer: [{blockId, start, end}], per notebook per document (SPEC.md §4)
  summaries     Json? // SUMMARIZE output: {layman?, intermediate?, professional?}, per notebook per document (SPEC.md §4)
  distillations Json? // DISTILL output: [{id, question, createdAt, quotes}], newest first, per notebook per document (SPEC.md §4)
  extractions   Json? // EXTRACT output: [{id, createdAt, origin, spans}], oldest first — the index gives the label (SPEC.md §4)
  formalized    Json? // FORMALIZE output: {article: {title, markdown, createdAt, createdById}}; Regenerate overwrites
  // The folder the document sits in within this project (SPEC.md §6); null
  // = the project itself, outside every folder. Deleting the folder moves
  // the document up one level (the route does it before the delete); the
  // database's own fallback clears it.
  folderId      String?
  folder        DocumentFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@id([notebookId, documentId])
  @@index([documentId])
  @@index([folderId])
}

// A folder (SPEC.md §6): a named group of a project's documents. A folder
// can hold folders (parentId; null = the project itself). The document list
// draws a folder as a row whose own list opens beside it. Deleting a folder
// moves what it holds up one level; the cascade here only covers the
// project's own delete.
model DocumentFolder {
  id         String             @id @default(cuid())
  notebookId String
  notebook   Notebook           @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  title      String
  parentId   String?
  parent     DocumentFolder?    @relation("FolderNesting", fields: [parentId], references: [id], onDelete: Cascade)
  children   DocumentFolder[]   @relation("FolderNesting")
  documents  NotebookDocument[]
  createdAt  DateTime           @default(now())

  @@index([notebookId])
  @@index([parentId])
}

model Block {
  id           String    @id @default(cuid())
  documentId   String
  document     Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  order        Int
  type         BlockType
  text         String // plain text content
  originalText String? // as first parsed; null = text is unedited. "" = user-authored block.
  html         String? // rendered content for figures/tables
  styles       Json? // inline decoration spans: [{start, end, style: "bold"|"italic"|"underline"|"code", quotedText}]
  citations    Json? // in-text citation spans: [{start, end, refId, quotedText}], refId → Document.references
  // TRANSCRIPT blocks: seconds into the video (SPEC.md §11).
  startTime    Float?
  endTime      Float?
  // TRANSCRIPT blocks: which speaker says this line — a speaker id from
  // VideoAsset.speakers (SPEC.md §11). Null = one voice, or not detected.
  speaker      String?
  links        Json? // link spans: [{start, end, quotedText, targetOrder?, href?}] — Contents entries and PDF hyperlinks
  // 1-based PDF page. FIGURE blocks: for the figure image route. PAGE blocks:
  // the page the block renders. Converted text blocks: the page it came from.
  page         Int?
  // FIGURE blocks from a PDF: the figure's region on its page, the percent-
  // coordinate shape of SPEC.md §11. Null = the whole page.
  region       Json?
  // Semantic search vector (text-embedding-3-small, 1024 dims). Null = not
  // embedded yet; the search route backfills lazily, a text edit clears it.
  embedding    Unsupported("vector(1024)")?
  // PAGE blocks: the page rendered once and kept (SPEC.md §16).
  pageImage    PageImage?

  @@index([documentId, order])
}

// Handwritten document (SPEC.md §16): a PAGE block's page rendered once and
// kept, so the page image route serves stored bytes instead of rendering the
// PDF on every request. width and height are the stored image's pixels: the
// reader lays the page out from them before the bytes arrive. data null =
// the size is known but the page is not rendered yet; the route renders it
// on its first request and fills the row.
model PageImage {
  blockId   String   @id
  block     Block    @relation(fields: [blockId], references: [id], onDelete: Cascade)
  width     Int
  height    Int
  data      Bytes? // JPEG at PAGE_IMAGE_WIDTH
  updatedAt DateTime @updatedAt
}

enum BlockType {
  PARAGRAPH
  HEADING
  FIGURE
  TABLE
  EQUATION
  LIST
  CODE
  SEPARATOR
  VIDEO // the video document's player block, exactly one per video document
  TRANSCRIPT // one transcript line, timed with startTime/endTime
  PAGE // one PDF page of a handwritten document; page holds the 1-based number
  SLIDE // one slide of a slides document (SPEC.md §27); page holds the 1-based slide number
  SHEET // the rows of one sheet of a sheets document, at most SHEET_ROWS_PER_BLOCK per block (SPEC.md §27)
}

enum ConversionStatus {
  NONE
  PENDING
  READY
  FAILED
  OFF // the reader said not to convert; the strip offers Convert to text, nothing auto-starts
}

// The video of a video document (SPEC.md §11). kind UPLOAD: bytes in
// VideoChunk rows, streamed with HTTP Range support by /api/video/[documentId];
// mimeType/size/chunkSize set. kind YOUTUBE: plays through the YouTube IFrame
// player; youtubeId set, no bytes stored.
model VideoAsset {
  id                  String           @id @default(cuid())
  documentId          String           @unique
  document            Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  kind                VideoKind        @default(UPLOAD)
  youtubeId           String?          @unique // kind YOUTUBE only; dedupes re-adds
  mimeType            String? // kind UPLOAD only
  size                Int? // kind UPLOAD only
  chunkSize           Int? // kind UPLOAD only
  duration            Float? // seconds; written by the client after metadata loads
  // The part of the recording that is imported (SPEC.md §15): the range the
  // reader picked in the upload box, seconds. Null = the whole recording. The
  // file stays whole; the transcript keeps the lines inside the range alone.
  clipStart           Float?
  clipEnd             Float?
  width               Int?
  height              Int?
  transcriptStatus    TranscriptStatus @default(NONE)
  transcriptError     String? // FAILED only: the reason, shown in the transcript pane
  // When the running transcription started. A PENDING older than 10 minutes is
  // a dead run and may start again.
  transcriptStartedAt DateTime?
  // The rungs the running attempt has tried and their reasons,
  // [{rung, reason}] (lib/video/transcription-job.ts): one attempt runs in
  // legs across functions, each past the rungs the last one tried. Null when
  // no attempt is between legs.
  transcriptTried     Json?
  // The voices heard in this media (SPEC.md §11): [{id, name}], the id on
  // each TRANSCRIPT block's speaker. Names come from the introductions; a
  // voice nobody names keeps "Speaker 2". Null = never detected.
  speakers            Json?
  // The file this media was uploaded to in Gemini's store, and when it stops
  // being readable (48 hours). A retry inside that window reuses it instead of
  // sending the bytes again — an hour-long file is the slow part of the run.
  geminiFileUri       String?
  geminiFileExpiresAt DateTime?
  chunks              VideoChunk[]
  createdAt           DateTime         @default(now())
}

enum VideoKind {
  UPLOAD
  YOUTUBE
}

model VideoChunk {
  id      String     @id @default(cuid())
  videoId String
  video   VideoAsset @relation(fields: [videoId], references: [id], onDelete: Cascade)
  index   Int
  data    Bytes

  @@unique([videoId, index])
}

enum TranscriptStatus {
  NONE
  PENDING
  READY
  FAILED
}

// Staging for PDF uploads larger than one request. Vercel caps a request body
// at about 4.5 MB, so the client splits big files into chunks (/api/uploads);
// /api/uploads/complete assembles them, runs normal ingest, and deletes the rows.
model UploadChunk {
  id        String   @id @default(cuid())
  uploadId  String
  index     Int
  data      Bytes
  createdAt DateTime @default(now())

  @@unique([uploadId, index])
  @@index([createdAt])
}

// AI usage telemetry (Scalae admin pattern): one row per model call, cost
// locked to list prices at call time. Writes are fire-and-forget — telemetry
// never breaks or slows a user-facing response. The admin usage page
// aggregates per function, model, user, and day.
model UsageEvent {
  id               String   @id @default(cuid())
  userId           String? // null = a background job with no signed-in reader
  provider         String // "anthropic" | "moonshot" | "google" | "groq" | "openai" | "microsoft" | "deepl"
  model            String
  feature          String // explain | simplify | … | assistant | act | glossary | transcribe | describe | voice
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  costUsd          Float
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

// Click telemetry (SPEC.md §7): one row per click on a reader control.
// surface is where the control lives (topbar | sidebar | ai-toolbar |
// article-menu | reader | tray, src/lib/clicks.ts); control is the control's
// id (its data-track attribute). The client batches clicks and posts them
// fire-and-forget — telemetry never breaks or slows the reader. The admin
// clicks page (/admin/clicks) aggregates per day, surface, control, and
// account; the daily cron deletes rows older than 180 days.
model ClickEvent {
  id         String   @id @default(cuid())
  userId     String? // null = no signed-in reader
  notebookId String? // the open project
  surface    String
  control    String
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([surface, control, createdAt])
  @@index([userId, createdAt])
}

// The onboarding funnel (README, Onboarding funnel): one row per step a
// visitor reaches on the way from the sign-in page to a subscription.
// visitorId is the browser's visitor cookie (dissect-visitor, set by the
// middleware); userId is the signed-in account, when there is one. The
// admin funnel page (/admin/funnel) joins the two: a visitor whose row ever
// carries an account is that account. step is one of lib/funnel.ts
// FUNNEL_STEPS. The daily cron deletes rows older than 365 days.
model FunnelEvent {
  id        String   @id @default(cuid())
  visitorId String? // null = a server event with no browser (the Stripe webhook)
  userId    String? // null = no signed-in reader
  step      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([visitorId, createdAt])
  @@index([userId, createdAt])
}

model Feedback {
  id        String         @id @default(cuid())
  category  String // "bug" | "idea" | "other"
  message   String
  // Photos attached to the feedback (SPEC.md §18): ImageAsset ids, read at
  // /api/images/<id>. Links attached: absolute http(s) URLs as typed.
  images    String[]       @default([])
  links     String[]       @default([])
  page      String? // pathname where it was filed
  userAgent String?
  // The account that filed it: a soft reference like Notebook.userId ("user-1"
  // = the local reader). Null = filed signed out, or before this column
  // existed; the admin cannot reply to those.
  userId    String?
  status    String         @default("new") // "new" | "seen" | "resolved"
  // The admin's replies (SPEC.md §18): each one a Notification of kind
  // "feedback" sent to the account that filed it.
  replies   Notification[]
  createdAt DateTime       @default(now())

  @@index([status, createdAt])
}

// One notification the admin sends to accounts (SPEC.md §18): kind, title,
// body, and one NotificationRecipient row per account it went to. The admin
// composes it on /admin/notifications, or Reply in the feedback inbox makes
// one (kind "feedback"); each recipient's dashboard shows it until they
// dismiss it. This is the admin's only write toward an account: nothing here
// reads a session or changes a User row.
model Notification {
  id         String                  @id @default(cuid())
  kind       String                  @default("update") // "update" (an update to Unitos) | "account" (a change made to the account) | "feedback" (a reply to feedback the account sent)
  title      String
  body       String // markdown
  // Kind "feedback" only: the feedback this notification replies to. The
  // feedback inbox lists a feedback's replies through it; the dashboard shows
  // the feedback's message above the reply.
  feedbackId String?
  feedback   Feedback?               @relation(fields: [feedbackId], references: [id], onDelete: SetNull)
  // A release notification (SPEC.md §18, lib/releases.ts): the release's id
  // and the language it was written in, "<release>:<lang>". The dashboard
  // writes one row per release per language the first time an account
  // opens it after the deploy. Null = sent by the admin.
  releaseKey String?                 @unique
  recipients NotificationRecipient[]
  createdAt  DateTime                @default(now())

  @@index([createdAt])
  @@index([feedbackId])
}

// One recipient of one notification. userId is a soft reference like
// Notebook.userId ("user-1" = the local reader when sign-in is off).
// dismissedAt null = open on the recipient's dashboard; Dismiss stamps it and
// the row stays, so the admin's dismissed count holds.
model NotificationRecipient {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  dismissedAt    DateTime?

  @@unique([notificationId, userId])
  @@index([userId, dismissedAt])
}

// The model the app calls for one role (lib/models.ts): the newest version
// of that model's family, as the provider's model list publishes it. One row
// per role, written by the bimonthly model update (/api/cron/models) and
// read by the model clients; no row = the constant in lib/derive/config.ts.
model ModelChoice {
  role            String   @id // "kimi" | "claude" | "gemini"
  modelId         String // the id the clients call
  previousModelId String   @default("") // the id before the last change; "" = never changed
  checkedAt       DateTime @default(now()) // the last run that checked this role
  changedAt       DateTime? // the last run that changed modelId
  note            String   @default("") // the last run's outcome for this role, for the admin page
}

// The model per feature (SPEC.md §2, lib/feature-models.ts): the id the
// admin set for one feature on the gateway page. One row per feature that
// leaves its default; no row = the constant in lib/derive/config.ts.
model FeatureModel {
  feature   String   @id // "explain" | "assistant" | "parse" | … (lib/feature-models.ts)
  modelId   String // the id the feature calls
  updatedAt DateTime @updatedAt
}

model ReaderProfile {
  id          String @id @default(cuid())
  userId      String @unique // constant in v1
  background  String // "Stanford student, stochastic calc + stats + quantum"
  purpose     String // "due diligence" | "exam prep" | "replicate results" | free text
  application String // "investment decision for Bough Capital" etc.
}

// A rating of one AI tool's output (SPEC.md §25): the reader's thumb on a
// card, a page, or an answer, with the input the tool ran on and the output
// it gave, so the tool quality loop (scripts/eval) can turn a poor answer
// into an eval case. Fire-and-forget from the client; never blocks a card.
model ToolRating {
  id         String   @id @default(cuid())
  userId     String? // null = no signed-in reader
  notebookId String?
  documentId String?
  noteId     String? // the annotation or conversation note the output lives on, when it has one
  tool       String // define | simplify | analyze | visualize | assistant | act | distill | summarize | ask | find | formalize | stitch
  rating     String // "up" | "down"
  lang       String // the reader's UI language at the time
  input      String // what the tool ran on: the selection, the question, the command (cut at 4000)
  output     String // what the tool answered (cut at 12000)
  comment    String? // what the reader typed after a thumb down, if anything
  createdAt  DateTime @default(now())

  @@index([tool, rating, createdAt])
  @@index([createdAt])
}
